{
 "instance": "sales",
 "metrics": [
  {
   "desc": "订单金额 × (1−折扣率) 的合计；折扣率缺失按 0 处理",
   "expr": "sum(net_amount)",
   "format": null,
   "name": "收入"
  },
  {
   "desc": "数量 × 商品标准成本 的合计（标准成本法，非实际采购价）",
   "expr": "sum(cost_amount)",
   "format": null,
   "name": "成本"
  },
  {
   "desc": "收入 − 成本",
   "expr": "sum(gross_profit)",
   "format": null,
   "name": "毛利"
  },
  {
   "desc": "毛利 ÷ 收入；收入为 0 时为空",
   "expr": "round(sum(gross_profit) / nullif(sum(net_amount), 0), 4)",
   "format": "percent",
   "name": "毛利率"
  },
  {
   "desc": "宽表行数（订单商品行，非订单数）",
   "expr": "count(*)",
   "format": null,
   "name": "订单行数"
  },
  {
   "desc": "去重客户数",
   "expr": "count(distinct customer_id)",
   "format": null,
   "name": "客户数"
  }
 ],
 "source": "instances/sales/metrics.yml"
}
