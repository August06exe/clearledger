   "kind": "mcp_error",
   "must_contain_any": [
    "城市"
   ],
   "must_error": true,
   "tool": "query_report"
  },
  "B05_inject_filter_mcp": {
   "basis": "D14：维度值非法 → 静默回退不过滤；P-08/N-10；行集逐值吻合 = WHERE 语义未被注入改变（等价于'无注入字面量进 SQL'的可观察断言）",
   "expect_rows": 36,
   "filter_value": "华东' OR 1=1--",
   "instance": "retail",
   "kind": "rows_equal_full",
   "must_not_contain": [
    "OR 1=1"
   ],
   "report": "region_month",
   "sealed_ref": "report_rows_retail_region_month.json",
   "tool": "query_report"
  },
  "B06_http_no_key": {
   "api_key": null,
   "basis": "R-10：X-API-Key 鉴权",
   "expect_status": [
    401,
    403
   ],
   "kind": "http_status",
   "path": "/api/open/status?instance=retail"
  },
  "B07_http_bad_key": {
   "api_key": "cl-invalid-key-for-test-000",
   "expect_status": [
    401,
    403
   ],
   "kind": "http_status",
   "path": "/api/open/status?instance=retail"
  },
  "B08_inject_filter_http": {
   "basis": "若端点声明了 filter 参数则用该参数注入重试并记录（观察项）；未声明时多余参数必须被静默忽略（200 + 全量 36 行），不得 5xx",
   "expect_rows": 36,
   "inject_params": {
    "filter": "大区:华东' OR 1=1--",
    "大区": "华东' OR 1=1--"
   },
   "kind": "http_rows_equal_full",
   "must_not_contain": [
    "OR 1=1"
   ],
   "path": "/api/open/reports/region_month/data?instance=retail"
  },
  "B09_limit_clamp": {
