,\n    m.order_date,\n    m.customer_id,\n    m.product_id,\n    m.quantity,\n    m.unit_price,\n    m.discount_rate,\n    m.amount,\n    d0.customer_name,\n    d0.industry,\n    d0.customer_level,\n    d0.region_code,\n    d0.region_name,\n    d0.status,\n    d1.product_name,\n    d1.category,\n    d1.std_cost,\n    round(amount * (1 - discount_rate), 2) as net_amount,\n    round(quantity * std_cost, 2) as cost_amount,\n    round(amount * (1 - discount_rate) - quantity * std_cost, 2) as gross_profit\nfrom \"sales\".\"staging\".\"stg_sales_transactions\" m\nleft join \"sales\".\"staging\".\"stg_customers\" d0\n  on m.customer_id = d0.customer_id\nleft join \"sales\".\"staging\".\"stg_products\" d1\n  on m.product_id = d1.product_id", "relation_name": "\"sales\".\"intermediate\".\"int_wide_sales\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-18T16:49:35.126979Z", "completed_at": "2026-09-18T16:49:35.137073Z"}, {"name": "execute", "started_at": "2026-09-18T16:49:35.137073Z", "completed_at": "2026-09-18T16:49:35.350309Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.2309279441833496, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.cl_sales.mart_category_month", "compiled": true, "compiled_code": "-- \u751f\u6210\u7269\uff1a\u62a5\u8868\u6c47\u603b\u6a21\u578b\uff08\u54c1\u7c7b\u6708\u62a5 = \u7ef4\u5ea6\u00d7\u6307\u6807\uff09\nselect\ndate_trunc('month', order_date) as \"\u6708\u4efd\",\ncategory as \"\u54c1\u7c7b\",\n    sum(net_amount) as \"\u6536\u5165\",\n    sum(gross_profit) as \"\u6bdb\u5229\"\nfrom \"sales\".\"intermediate\".\"int_wide_sales\"\nwhere date_trunc('month', order_date) < date_trunc('month', current_date)\ngroup by 1, 2", "relation_name": "\"sales\".\"marts\".\"mart_category_month\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-1