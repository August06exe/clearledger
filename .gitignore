# Python
.venv/
__pycache__/
*.pyc
*.egg-info/

# 数据与运行时产物（不入库：仓库只放代码与配置）
data/
/logs/

# dbt 产物
pipeline/target/
pipeline/logs/
pipeline/dbt_packages/

# 系统
.DS_Store
Thumbs.db
nul

# 实例生成管道的 dbt 构建产物（生成源码 instances/*/pipeline/models 保留入库）
instances/*/pipeline/target/
instances/*/pipeline/logs/

# 回收站（退役资产暂存，确认无用后可整体删除）
_trash/

# internal/ 开发过程文档（决策记录/迭代日志/设计稿/历史归档——内部材料，不入公开仓库）
internal/

# 开放接口 API Key（敏感，不入库；模板见 openapi_keys.example.json）
data/openapi_keys.json

# PyInstaller 打包产物（成品 exe 走 GitHub Releases，仓库只留源码）
build/
dist/
*.spec
启动明账.exe

# 门户静态目录不放内容图（图片统一在 docs/assets，预览用副本不入库）
app/static/*.png

# 截图工作区（候选/参考图，不公开）
docs/assets/_red/


# ---- 仓库治理（2026-09-21 审计后新增）----
# 工具会话残留
.zcode/
# 运行日志与 stdout/stderr 碎片
*_stderr.txt
*_stdout.txt
# 工作台配置快照（save 自动备份，属运行痕迹）
instances/*/onboarding/config_history/
tests/fixtures/instances/*/onboarding/config_history/
# 摄取/匹配契约运行产物（随跑批重写）
instances/*/pipeline/contract_tests.json
# dbt 本机用户标识
instances/*/pipeline/.user.yml
# 测试运行证据：判分器代码(.py)保留，其余每轮现采现清
tests/v0.4/judge/**
!tests/v0.4/judge/*.py
tests/v0.5/judge/**
!tests/v0.5/judge/*.py
tests/v0.6/judge/**
!tests/v0.6/judge/*.py
