# Python
.venv/
__pycache__/
*.pyc
*.egg-info/

# 数据与运行时产物（不入库：仓库只放代码与配置）
data/
logs/

# dbt 产物
pipeline/target/
pipeline/logs/
pipeline/dbt_packages/

# 系统
.DS_Store
Thumbs.db
nul

# 实例生成管道的 dbt 构建产物（生成源码 instances/*/pipeline/models 保留入库）
instances/*/pipeline/target/
instances/*/pipeline/logs/

# 回收站（退役资产暂存，确认无用后可整体删除）
_trash/

# 开放接口 API Key（敏感，不入库；模板见 openapi_keys.example.json）
data/openapi_keys.json

# PyInstaller 打包产物（成品 exe 直接提交根目录，中间物不入库）
build/
dist/
*.spec

# 门户静态目录不放内容图（图片统一在 docs/assets，预览用副本不入库）
app/static/*.png

# 截图工作区（候选/参考图，不公开）
docs/assets/_red/

# 实地试点（影子客户模拟）内部材料，不入公开仓库
pilot/
